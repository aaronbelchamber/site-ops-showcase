{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "manage.py",
        "runserver",
        "--port",
        "63010",
        "--no-debug"
      ],
      "port": 63010,
      "url": "http://127.0.0.1:63010",
      "health": "/health"
    },
    {
      "name": "dev server",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && npm run dev"
      ],
      "port": 63014,
      "url": "http://127.0.0.1:63014",
      "depends_on": [
        "backend"
      ]
    },
    {
      "name": "health-dashboard",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "manage.py",
        "health-dashboard",
        "--port",
        "63016",
        "--no-debug"
      ],
      "port": 63016,
      "url": "http://127.0.0.1:63016",
      "health": "/health"
    }
  ]
}
