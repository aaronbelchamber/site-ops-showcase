# WordPress Site Manager Environment Configuration
# Copy this file to config/.env and replace values as needed.

# Secret key for Fernet credential encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_KEY=replace_with_your_generated_fernet_key

# Flask Server Port
PORT=5000

# Automated System Backup Google Drive Sync Path (Optional)
# Example Windows path: GOOGLE_DRIVE_BACKUP_PATH=G:\My Drive\SiteManagerBackups
# Example Linux path: GOOGLE_DRIVE_BACKUP_PATH=/home/user/GoogleDrive/SiteManagerBackups
GOOGLE_DRIVE_BACKUP_PATH=

# Backup and Log Retention Settings
BACKUP_RETENTION_DAYS=30
LOG_RETENTION_DAYS=14
